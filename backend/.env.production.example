# ============================================
# AutoTest AI Backend Production Configuration
# Use this for Hugging Face Spaces / Cloud Deploy
# ============================================

# ---------- Application ----------
APP_NAME=AutoTestAI
APP_VERSION=1.0.0
APP_ENV=production
LOG_LEVEL=INFO
PORT=7860

# ---------- CORS Settings ----------
# Comma-separated list of allowed frontend URLs (e.g., your Vercel deployment URL)
CORS_ORIGINS=https://autotest-ai.vercel.app,http://localhost:3000

# ---------- Database (MongoDB Atlas) ----------
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=autotest_prod

# ---------- Redis (Upstash or Managed Redis) ----------
REDIS_URL=rediss://default:<password>@<host>:<port>

# ---------- Neo4j (Neo4j AuraDB Cloud) ----------
NEO4J_URI=neo4j+s://<db-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-aura-password>
NEO4J_DATABASE=neo4j

# ---------- Vector Store (ChromaDB) ----------
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ---------- LLM Providers ----------
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...
HUGGINGFACE_API_TOKEN=hf_...
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
DEFAULT_TEMPERATURE=0.1

# ---------- Security & JWT ----------
JWT_SECRET=<generate-strong-random-secret-key-32-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
